<!DOCTYPE html>
<html lang="pt-BR">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Login - FrotaPM</title>

<link rel="stylesheet" href="../../assets/css/login.css">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

</head>

<body>

<div class="background"></div>

<div class="login-box">

<div class="logo">

<i class="fa-solid fa-shield-halved"></i>

<h1>FrotaPM</h1>

<p>Polícia Militar de Blumenau</p>

</div>

<form>

<div class="inputBox">

<i class="fa-solid fa-user"></i>

<input
type="text"
id="usuario"
placeholder="Usuário"
required>

</div>

<div class="inputBox">

<i class="fa-solid fa-lock"></i>

<input
type="password"
id="senha"
placeholder="Senha"
required>

<button
type="button"
class="mostrarSenha"
onclick="mostrarSenha()">

<i
class="fa-solid fa-eye"
id="iconeSenha">
</i>

</button>

</div>

<label>

<input
type="checkbox">

Lembrar acesso

</label>

<button
type="button"
class="entrar"
onclick="login()">

Entrar

</button>

<a href="#">Esqueci minha senha</a>

</form>

</div>

<script src="../../assets/js/login.js"></script>

</body>

</html>
