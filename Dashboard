<!DOCTYPE html>
<html lang="pt-BR">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Dashboard | FrotaPM</title>

<link rel="stylesheet" href="../../assets/css/menu.css">
<link rel="stylesheet" href="../../assets/css/dashboard.css">
<link rel="stylesheet" href="../../assets/css/cards.css">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

<link rel="stylesheet"
href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

</head>

<body>

<aside class="sidebar">

<div class="logo">

<i class="fa-solid fa-shield-halved"></i>

<h2>FrotaPM</h2>

</div>

<ul>

<li class="ativo" onclick="location.href='index.html'">
<i class="fa-solid fa-house"></i>
Dashboard
</li>

<li onclick="location.href='../viaturas/index.html'">
<i class="fa-solid fa-car"></i>
Viaturas
</li>

<li onclick="location.href='../manutencao/index.html'">
<i class="fa-solid fa-screwdriver-wrench"></i>
Manutenção
</li>

<li onclick="location.href='../rastreamento/index.html'">
<i class="fa-solid fa-location-dot"></i>
Rastreamento
</li>

<li>
<i class="fa-solid fa-chart-column"></i>
Relatórios
</li>

</ul>

</aside>

<main>

<header class="cabecalho">

<div>

<h1>Dashboard</h1>

<p>Sistema de Gestão da Frota da Polícia Militar</p>

</div>

<div class="usuario">

<i class="fa-solid fa-user-police"></i>

Administrador

</div>

</header>

<section class="dashboardCards">

<div class="cardSistema">

<i class="fa-solid fa-car"></i>

<div>

<h2 id="totalViaturas">0</h2>

<p>Total de Viaturas</p>

</div>

</div>

<div class="cardSistema">

<i class="fa-solid fa-circle-check"></i>

<div>

<h2 id="disponiveis">0</h2>

<p>Disponíveis</p>

</div>

</div>

<div class="cardSistema">

<i class="fa-solid fa-screwdriver-wrench"></i>

<div>

<h2 id="manutencao">0</h2>

<p>Em Manutenção</p>

</div>

</div>

<div class="cardSistema">

<i class="fa-solid fa-location-dot"></i>

<div>

<h2 id="patrulhamento">0</h2>

<p>Patrulhamento</p>

</div>

</div>

</section>

<section class="graficos">

<div class="grafico">

<h3>Distribuição da Frota</h3>

<canvas id="graficoPizza"></canvas>

</div>

<div class="grafico">

<h3>Custos Mensais</h3>

<canvas id="graficoLinha"></canvas>

</div>

</section>

<section class="inferior">

<div class="alertas">

<h3>Alertas</h3>

<ul id="listaAlertas">

<li>Nenhum alerta encontrado.</li>

</ul>

</div>

<div class="miniMapa">

<h3>Localização Geral</h3>

<div id="mapaMini"></div>

</div>

</section>

</main>

<script src="../../assets/js/dashboard.js"></script>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

</body>

</html>




