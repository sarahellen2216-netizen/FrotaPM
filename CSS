*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{

height:100vh;

display:flex;

justify-content:center;

align-items:center;

background:#0b2447;

overflow:hidden;

}

.background{

position:fixed;

width:100%;

height:100%;

background:linear-gradient(135deg,#0b2447,#19376d,#576cbc);

z-index:-1;

}

.login-box{

width:420px;

background:white;

padding:40px;

border-radius:20px;

box-shadow:0 15px 40px rgba(0,0,0,.3);

}

.logo{

text-align:center;

margin-bottom:30px;

}

.logo i{

font-size:60px;

color:#0b5ed7;

margin-bottom:10px;

}

.logo h1{

color:#0b2447;

}

.logo p{

color:#666;

}

.inputBox{

position:relative;

margin-top:20px;

}

.inputBox input{

width:100%;

padding:15px 45px;

border:1px solid #ccc;

border-radius:10px;

font-size:16px;

}

.inputBox i:first-child{

position:absolute;

left:15px;

top:17px;

color:#0b5ed7;

}

.mostrarSenha{

position:absolute;

right:10px;

top:10px;

border:none;

background:none;

cursor:pointer;

font-size:18px;

color:#555;

}

.entrar{

width:100%;

padding:15px;

margin-top:25px;

background:#0b5ed7;

color:white;

border:none;

border-radius:10px;

font-size:18px;

cursor:pointer;

transition:.3s;

}

.entrar:hover{

background:#084298;

}

label{

display:block;

margin-top:20px;

}

a{

display:block;

margin-top:20px;

text-align:center;

text-decoration:none;

color:#0b5ed7;

}
