<!DOCTYPE html>
<html lang="pt-BR">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Viaturas | FrotaPM</title>

<link rel="stylesheet" href="../../assets/css/dashboard.css">
<link rel="stylesheet" href="../../assets/css/menu.css">
<link rel="stylesheet" href="../../assets/css/viaturas.css">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

</head>

<body>

<!-- MENU -->

<aside class="sidebar">

<div class="logo">

<i class="fa-solid fa-shield-halved"></i>

<h2>FrotaPM</h2>

</div>

<ul>

<li onclick="location.href='../dashboard/index.html'">
<i class="fa-solid fa-house"></i>
Dashboard
</li>

<li class="ativo">
<i class="fa-solid fa-car"></i>
Viaturas
</li>

<li>
<i class="fa-solid fa-screwdriver-wrench"></i>
Manutenção
</li>

<li>
<i class="fa-solid fa-location-dot"></i>
Rastreamento
</li>

<li>
<i class="fa-solid fa-chart-column"></i>
Relatórios
</li>

</ul>

</aside>

<!-- CONTEÚDO -->

<main>

<header class="topo">

<h1>Cadastro de Viaturas</h1>

<button onclick="abrirModal()">

<i class="fa-solid fa-plus"></i>

Nova Viatura

</button>

</header>

<div class="pesquisa">

<input
type="text"
id="pesquisa"
placeholder="Pesquisar viatura..."
onkeyup="pesquisarViatura()">

</div>

<table>

<thead>

<tr>

<th>Prefixo</th>

<th>Placa</th>

<th>Modelo</th>

<th>Ano</th>

<th>Unidade</th>

<th>Quilometragem</th>

<th>Status</th>

<th>Ações</th>

</tr>

</thead>

<tbody id="listaViaturas">

</tbody>

</table>

</main>

<!-- MODAL -->

<div
class="modal"
id="modal">

<div class="conteudo">

<h2>Cadastro de Viatura</h2>

<input id="prefixo" placeholder="Prefixo">

<input id="placa" placeholder="Placa">

<input id="modelo" placeholder="Modelo">

<input id="ano" placeholder="Ano">

<input id="unidade" placeholder="Unidade">

<input
id="km"
type="number"
placeholder="Quilometragem">

<select id="status">

<option>Disponível</option>

<option>Patrulhamento</option>

<option>Manutenção</option>

</select>

<div class="botoes">

<button
class="salvar"
onclick="salvarViatura()">

Salvar

</button>

<button
class="cancelar"
onclick="fecharModal()">

Cancelar

</button>

</div>

</div>

</div>

<script src="../../assets/js/viaturas.js"></script>

</body>

</html>
